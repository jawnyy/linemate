# Copy this file to .env and fill in real values.
#   cp .env.example .env

# --- API security ---
# Required on every route except GET /. Set this to any value you like for
# local dev; callers must send it back as the X-API-Key header.
API_KEY=changeme-local-dev-key

# --- Seed data paths ---
# Paths are relative to wherever you run `fastapi dev` / `uvicorn` from
# (typically the backend/ directory).
DOCUMENTS_CSV_PATH=documents.csv
TICKETS_CSV_PATH=tickets.csv
CREW_CSV_PATH=crew.csv

# --- Analytics ---
# A document is "stale" if it hasn't been reviewed in this many days.
# Used by /documents/stale and /analytics/ownership (overridable there via
# the ?threshold= query param).
STALENESS_THRESHOLD_DAYS=90

# --- Ollama ---
# Ollama must be running locally with both models pulled:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# --- Vector store ---
# Where the Chroma collection is persisted. Built automatically on the
# first call to /ask if this directory doesn't already exist or is empty.
CHROMA_PERSIST_DIR=chroma_db

# --- Chunking ---
# Passed to the text splitter when building the vector store from
# documents.csv. Character counts, not tokens.
CHUNK_SIZE=500
CHUNK_OVERLAP=50
